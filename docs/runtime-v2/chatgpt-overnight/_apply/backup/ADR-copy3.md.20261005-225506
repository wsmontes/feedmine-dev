public struct EditorialSourceKey: Hashable, Sendable, Codable {
    public let catalogIdentity: String
    public let canonicalizationVersion: Int
}

/// D3: the only sanctioned conversion from legacy integers.
public enum LocalIDError: Error { case nonPositive, outOfRange }
public func encodeLocalID(_ rawValue: Int64) throws -> Int64   // throws on 0, negatives

/// D16: identity confidence travels with the mapped key.
public enum IdentityConfidence: String, Sendable, Codable { case high, low }
public struct ExternalIdentityRef: Hashable, Sendable {
    public let scope: ConnectorScopeID
    public let key: ExternalObjectKey
    public let confidence: IdentityConfidence
    public let fallbackSchemeVersion: Int?          // non-nil iff confidence == .low
}
