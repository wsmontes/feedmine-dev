    public let rawValue: UInt64
    public init(rawValue: UInt64)                    // precondition: rawValue > 0
}
public struct ProviderID: Hashable, Sendable, Codable { public let rawValue: UInt64 }
public struct OriginRecordID: Hashable, Sendable, Codable { public let rawValue: Int64 }   // > 0
public struct OriginRevisionID: Hashable, Sendable, Codable { public let rawValue: Int64 } // > 0
public struct SourceBindingID: Hashable, Sendable, Codable { public let rawValue: Int64 }  // > 0
public struct AcquisitionTargetID: Hashable, Sendable, Codable { public let rawValue: Int64 }

/// D8: key space of external identity. The core never interprets either part.
public struct ConnectorScopeID: Hashable, Sendable, Codable {
    public let connectorNamespace: String
    public let scopeKey: String
}
public struct ExternalObjectKey: Hashable, Sendable { public let bytes: Data }
public struct ExternalVersionKey: Hashable, Sendable { public let bytes: Data }  // opaque, unordered (D9)
public struct ExternalKeyDigest: Hashable, Sendable { public let bytes: Data }   // 128-bit, index only (D8)

